# Puertos de Servicios
PORT_GATEWAY=8080
PORT_GATEWAY_PUBLIC=8080
PORT_USER_AUTH=8081

# Conexión Base de Datos
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Nombre de los Hosts
HOST_USER_AUTH=user-auth

# Nombre de las bases de datos
DB_USER_AUTH_NAME=

# Perfil
SPRING_PROFILES_ACTIVE=dev

# Liquibase
LIQUIBASE_ENABLED=false

# Configuración de Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Configuración de la URL pública de la aplicación
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CONFIRM_TTL_HOURS=24
APP_RESEND_COOLDOWN_SECONDS=60